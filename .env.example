# Copy to .env and fill in
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
DB_PATH=./data/porikkha.db
ADMIN_EMAIL=admin@porikkha.local
ADMIN_PASSWORD=Admin123!
# Free plan daily caps
FREE_EXAMS_PER_DAY=3
FREE_PRACTICE_PER_DAY=20
# Reset tokens (v1: printed to console + data/reset-tokens.log)
RESET_TOKEN_TTL_MIN=30
